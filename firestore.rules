rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Governance Helper Functions ---

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      // Use exists() check to prevent rule evaluation errors if doc is missing
      let path = /databases/$(database)/documents/user/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function getRole() {
      let data = getUserData();
      return isUserAuthenticated() && data != null ? data.roleId : null;
    }

    function isCEO() {
      let role = getRole();
      return isUserAuthenticated() && (role == 'CEO' || role == 'ceo' || request.auth.token.email == 'ceo@faim.com');
    }

    function isChiefAccountant() {
      let role = getRole();
      return isUserAuthenticated() && (role == 'Chief Accountant' || role == 'CHIEF ACCOUNTANT' || role == 'CHIEF_ACCOUNTANT');
    }

    function isAdmin() {
      let role = getRole();
      return isUserAuthenticated() && (role == 'Administrator' || role == 'ADMINISTRATOR' || role == 'ADMIN' || role == 'Admin');
    }

    // --- Directory & Profile Isolation ---

    match /user/{userId} {
      allow get: if isUserAuthenticated() && (request.auth.uid == userId || isCEO() || isAdmin());
      allow list: if isCEO() || isAdmin();
      allow create: if isCEO() || request.auth.token.email == 'ceo@faim.com'; 
      allow update: if isUserAuthenticated() && (request.auth.uid == userId || isCEO());
      allow delete: if isCEO();
    }

    match /role_permissions/{roleId} {
      allow read: if isUserAuthenticated();
      allow write: if isCEO();
    }

    // --- Operational Collections ---

    match /workflow_audit/{docId} {
        // Explicitly allow audit logs for any authenticated user involved in the workflow
        allow create: if isUserAuthenticated();
        allow read: if isUserAuthenticated() && (isCEO() || isChiefAccountant() || isAdmin());
    }

    match /workflow_triggers/{triggerId} {
      allow get: if isUserAuthenticated();
      allow list: if isUserAuthenticated();
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated();
      allow delete: if isCEO();
    }

    match /activity_logs/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /invoices/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /properties/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /leads/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /promotions/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /amendments/{docId} {
      allow read, write: if isUserAuthenticated();
    }

    match /settings/{docId} {
      allow read: if isUserAuthenticated();
      allow write: if isCEO() || isAdmin();
    }

    match /roles/{docId} {
      allow read: if isUserAuthenticated();
      allow write: if isCEO() || isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isUserAuthenticated();
      allow create: if isUserAuthenticated();
      // Allow authenticated update to clients during transaction to prevent blockages 
      // while user profiles are syncing UID mappings.
      allow update: if isUserAuthenticated();
      allow delete: if isCEO();
    }

    match /milestones/{docId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserAuthenticated();
    }

    match /internal_mails/{mailId} {
      allow read: if isUserAuthenticated() && (isCEO() || request.auth.uid in resource.data.participants);
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // --- System Catch-all ---

    match /{path=**} {
      allow read, write: if isCEO();
    }
  }
}