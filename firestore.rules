
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fail-safe check for CEO role. 
    // Uses exists() to prevent errors if the user document is missing during sign-up/bootstrap.
    function isCEO() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/user/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/user/$(request.auth.uid)).data.roleId == 'CEO';
    }

    // Generic Permission Check with Existence Verification
    function can(module, action) {
      // 1. Get User Document safely
      let userDocPath = /databases/$(database)/documents/user/$(request.auth.uid);
      
      // 2. If user doc exists, get the role
      let role = exists(userDocPath) ? get(userDocPath).data.roleId : null;
      
      // 3. If role exists, get permissions document
      let permDocPath = /databases/$(database)/documents/role_permissions/$(role);
      
      // 4. Check if permission allows action. 
      // Returns false if any document is missing to be safe (fail-closed).
      return role != null && 
             exists(permDocPath) && 
             get(permDocPath).data.modules[module][action] == true;
    }

    // --- Collection Rules ---

    // 1. Company Settings (Public Read for Login Page Branding)
    match /settings/{docId} {
      allow read: if true; 
      allow write: if isAuthenticated() && (isCEO() || can('Settings', 'edit'));
    }

    // 2. Users (Staff Profiles)
    match /user/{userId} {
      // Allow reading any user profile if authenticated (needed for lists, assigning tasks)
      allow read: if isAuthenticated();
      
      // Allow creation if:
      // a) It's the user creating their own profile (Bootstrapping)
      // b) It's a CEO
      // c) It's a user with 'Settings' create permission
      allow create: if isAuthenticated() && (request.auth.uid == userId || isCEO() || can('Settings', 'create'));
      
      // Allow updates if self or admin
      allow update: if isAuthenticated() && (request.auth.uid == userId || isCEO() || can('Settings', 'edit'));
      
      // Delete restricted to admins
      allow delete: if isAuthenticated() && (isCEO() || can('Settings', 'delete'));
    }

    // 3. Roles & Permissions 
    // Must be readable by all authenticated users so the frontend can determine UI visibility
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isCEO() || can('Settings', 'edit'));
    }
    
    match /role_permissions/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isCEO() || can('Settings', 'edit'));
    }

    // 4. Activity Logs
    match /activity_logs/{logId} {
      allow read: if isAuthenticated(); // Allow users to see history
      allow create: if isAuthenticated(); // Any auth user can log an action
      allow update, delete: if false; // Audit trail is immutable
    }

    // 5. Clients Module
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isCEO() || can('Clients', 'view'));
      allow create: if isAuthenticated() && (isCEO() || can('Clients', 'create'));
      allow update: if isAuthenticated() && (isCEO() || can('Clients', 'edit'));
      allow delete: if isAuthenticated() && (isCEO() || can('Clients', 'delete'));
    }

    // 6. Leads Management Module
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (isCEO() || can('Leads Management', 'view'));
      allow create: if isAuthenticated() && (isCEO() || can('Leads Management', 'create'));
      allow update: if isAuthenticated() && (isCEO() || can('Leads Management', 'edit'));
      allow delete: if isAuthenticated() && (isCEO() || can('Leads Management', 'delete'));
    }

    // 7. Properties (CEO Hub / Admin)
    match /properties/{propertyId} {
      // Read allowed for all auth users (used in dropdowns, forms)
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated() && (isCEO() || can('CEO Hub', 'create'));
      allow update: if isAuthenticated() && (isCEO() || can('CEO Hub', 'edit'));
      allow delete: if isAuthenticated() && (isCEO() || can('CEO Hub', 'delete'));
    }

    // 8. Invoices (Account Management)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (isCEO() || can('Account Management', 'view') || can('Clients', 'view'));
      allow create: if isAuthenticated() && (isCEO() || can('Account Management', 'create'));
      allow update: if isAuthenticated() && (isCEO() || can('Account Management', 'edit'));
      allow delete: if isAuthenticated() && (isCEO() || can('Account Management', 'delete'));
    }

    // 9. Promotions
    match /promotions/{promoId} {
      allow read: if isAuthenticated(); // Visible to all staff
      allow create: if isAuthenticated() && (isCEO() || can('Promotions', 'create'));
      allow update: if isAuthenticated() && (isCEO() || can('Promotions', 'edit'));
      allow delete: if isAuthenticated() && (isCEO() || can('Promotions', 'delete'));
    }

    // 10. Amendments
    match /amendments/{docId} {
      allow read: if isAuthenticated() && (isCEO() || can('Clients', 'view'));
      allow create: if isAuthenticated() && (isCEO() || can('Clients', 'edit'));
      allow update: if isAuthenticated() && (isCEO() || can('Clients', 'approve')); 
      allow delete: if isAuthenticated() && (isCEO() || can('Clients', 'delete'));
    }
  }
}
